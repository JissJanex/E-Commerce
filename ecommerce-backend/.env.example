# HTTP server
PORT=5000

# Supabase
# Find these values in your Supabase project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay
# Use test credentials for local development.
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend
# Required for order-confirmation emails.
RESEND_API_KEY=re_xxxxx

# Scheduled cleanup endpoint
# Use a long, randomly generated value.
CRON_SECRET=replace_with_a_long_random_value
